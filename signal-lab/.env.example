# Wyckoff Signal Lab — environment configuration
# Copy to .env and fill in your values

# Comma-separated symbols to scan
SYMBOLS=BTCUSD,XAUUSD

# Primary analysis timeframe (M1/M5/M15/M30/H1/H4/D1/W1)
TIMEFRAME=H1

# Higher timeframe for trend confirmation
HTF=H4

# How often to scan (seconds)
SCAN_INTERVAL=60

# Number of bars to load per scan
LOOKBACK=200

# Volume analysis settings
VOL_LOOKBACK=20
VOL_SPIKE_MULT=2.0
VOL_DRYUP_RATIO=0.5
